generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: DATABASE_URL in .env — use Supabase connection string in production

// ─── Site Settings ───────────────────────────────────────────
model SiteSettings {
  id              String   @id @default("default")
  siteName        String   @default("REDMEDYA.CO")
  whatsappNumber  String   @default("905551234567")
  phoneNumber     String   @default("905551234567")
  instagramUrl    String?
  metaPixelId     String?
  heroVideoUrl    String?
  heroPosterUrl   String?
  urgencyMessage  String?  @default("2026 sezonu doluyor — erken rezervasyon avantajı")
  seoTitle        String?
  seoDescription  String?
  updatedAt       DateTime @updatedAt
}

// ─── Services (Package Builder) ──────────────────────────────
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  price       Int
  category    String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)
  upsellHint  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  couponRestrictions CouponService[]
}

// ─── Coupons ─────────────────────────────────────────────────
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  type            CouponType
  value           Float
  minOrderAmount  Int?
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  influencerName  String?
  serviceSpecific Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  services CouponService[]
}

model CouponService {
  couponId  String
  serviceId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([couponId, serviceId])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ─── Stories (Netflix slider) ────────────────────────────────
model Story {
  id          String   @id @default(cuid())
  title       String
  coupleNames String
  venue       String?
  quote       String?
  imageUrl    String
  videoUrl    String?
  reelsUrl    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Testimonials ────────────────────────────────────────────
model Testimonial {
  id          String          @id @default(cuid())
  coupleNames String
  content     String
  rating      Int             @default(5)
  venue       String?
  imageUrl    String?
  videoUrl    String?
  source      TestimonialSource @default(INSTAGRAM)
  isPublished Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
}

enum TestimonialSource {
  INSTAGRAM
  GOOGLE
  VIDEO
  DIRECT
}

// ─── Blog ────────────────────────────────────────────────────
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Hero / Slider CMS ───────────────────────────────────────
model HeroSlide {
  id        String  @id @default(cuid())
  title     String?
  subtitle  String?
  videoUrl  String?
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

// ─── Leads / Reservations ────────────────────────────────────
model Lead {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  phone        String
  weddingDate  DateTime?
  note         String?
  servicesJson String   @db.Text
  subtotal     Int
  discount     Int      @default(0)
  total        Int
  couponCode   String?
  source       String?  @default("website")
  status       LeadStatus @default(NEW)
  createdAt    DateTime @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  LOST
}

// ─── VIP Couples ─────────────────────────────────────────────
model VipUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  coupleNames  String
  weddingDate  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  deliveries VipDelivery[]
}

model VipDelivery {
  id          String   @id @default(cuid())
  vipUserId   String
  title       String
  description String?
  fileUrl     String?
  thumbUrl    String?
  isReady     Boolean  @default(false)
  createdAt   DateTime @default(now())

  vipUser VipUser @relation(fields: [vipUserId], references: [id], onDelete: Cascade)
}

// ─── Admin Users ─────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         AdminRole @default(EDITOR)
  createdAt    DateTime @default(now())
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}
