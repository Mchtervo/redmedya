# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
telegram.env

# Repo'daki data/*.json tohum (seed) dosyalarıdır. Canlı yazmalar üretimde
# ~/redmedya-data (DATA_DIR) üzerindedir; git checkout canlı dosyayı ezmez.
# Seed kopyaları PII içerebilir — repo PRIVATE kalmalı.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

.commit-msg.tmp

# yalnızca tracking runtime verisi (yeniden üretilir, commit edilmez)
/data/events.jsonl

# Rezervasyon otomatik yedekleri (canli veri, repoya girmez)
/data/backups/

# Anonim ziyaret sayaci (canli veri, runtime uretilir)
/data/visits.json

# Funnel / analytics runtime (deploy ile silinmesin diye git'te yok; DATA_DIR'de durur)
/data/analytics_events.jsonl
/data/analytics_sessions.json
/data/analytics_tech_errors.json
/data/analytics_event_ids.json

# CAPI backfill isaret dosyasi (runtime, mükerrer gönderimi engeller)
/data/capi_backfill_sent.json
